# Local defaults only. Copy to .env; do not commit .env or keystores.
# The password below is a disposable local Docker credential, never a hosted DB credential.
DATABASE_URL=postgresql://looppay:local-development-only@127.0.0.1:5432/looppay?schema=public
LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# NEXT_PUBLIC values are public browser configuration: never put API secrets in these URLs.
# Populate from your own deployment; all addresses intentionally blank.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_CHECKOUT_ADDRESS=
NEXT_PUBLIC_REWARDS_ADDRESS=
NEXT_PUBLIC_STABLECOIN_ADDRESS=
NEXT_PUBLIC_TOKEN_SYMBOL=TESTUSD
NEXT_PUBLIC_TOKEN_DECIMALS=6
STABLECOIN_ADDRESS=
# Public deployer address and encrypted keystore account NAME only. Never put a private key here.
DEPLOYER_ADDRESS=
DEPLOYER_ACCOUNT=
# Official source: docs.qie.digital/getting-started-with-qie-blockchain/4.-access-mainnet-or-testnet
# Copy the current RPC and explorer from that source after confirming them. Testnet chain ID is 1983.
QIE_TESTNET_RPC_URL=
QIE_RPC_URL=
QIE_MAINNET_RPC_URL=
QIE_MAINNET_CHAIN_ID=
QIE_MAINNET_STABLECOIN_ADDRESS=
# No API endpoint/workflow was confirmed in the QIE docs during implementation.
# Enable only if official QIE documentation/support confirms Blockscout verification compatibility.
QIE_TESTNET_VERIFIER_URL=
QIE_VERIFICATION_WORKFLOW_CONFIRMED=false
VERIFY_CONTRACT_ADDRESS=
VERIFY_CONTRACT_NAME=
VERIFY_CONSTRUCTOR_ARGS=
# MUST equal the first registry deployment block; fresh database per network/deployment.
DEPLOYMENT_BLOCK=
INDEXER_CONFIRMATIONS=12
# Synthetic analytics only, local chain only; disabled by default.
DEMO_MODE=false
